{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp.ReverseProxy": "Information"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Key": "Wf-Items-2026-MasterRad-JWT-Key-z9XmK2pLqR5nYwBvEuHcJ",
    "Issuer": "WarframeApp",
    "Audience": "WarframeApp"
  },
  "Gateway": {
    "RateLimiting": {
      "Api": {
        "PermitLimit": 120,
        "WindowSeconds": 60
      },
      "Authentication": {
        "PermitLimit": 10,
        "WindowSeconds": 60
      }
    },
    "ApostropheTransformation": {
      "Enabled": true,
      "MaxRequestBodyBytes": 1048576,
      "MaxResponseBodyBytes": 4194304
    }
  },
  "ReverseProxy": {
    "Routes": {
      "users-register": {
        "ClusterId": "users-directory",
        "Order": -100,
        "AuthorizationPolicy": "Anonymous",
        "RateLimiterPolicy": "Authentication",
        "Match": {
          "Path": "/v1/directory/register",
          "Methods": [ "POST" ]
        }
      },
      "users-login": {
        "ClusterId": "users-directory",
        "Order": -100,
        "AuthorizationPolicy": "Anonymous",
        "RateLimiterPolicy": "Authentication",
        "Match": {
          "Path": "/v1/directory/login",
          "Methods": [ "POST" ]
        }
      },
      "users-admin-list": {
        "ClusterId": "users-directory",
        "Order": -90,
        "AuthorizationPolicy": "AdminOnly",
        "RateLimiterPolicy": "Gateway",
        "Match": {
          "Path": "/v1/directory/users",
          "Methods": [ "GET" ]
        }
      },
      "users-admin-user": {
        "ClusterId": "users-directory",
        "Order": -90,
        "AuthorizationPolicy": "AdminOnly",
        "RateLimiterPolicy": "Gateway",
        "Match": {
          "Path": "/v1/directory/user",
          "Methods": [ "GET", "PATCH", "DELETE" ]
        }
      },
      "users-self-service": {
        "ClusterId": "users-directory",
        "AuthorizationPolicy": "Authenticated",
        "RateLimiterPolicy": "Gateway",
        "Match": {
          "Path": "/v1/directory/user/me/{**catch-all}"
        }
      },
      "items-read": {
        "ClusterId": "items-store",
        "AuthorizationPolicy": "Anonymous",
        "RateLimiterPolicy": "Gateway",
        "Match": {
          "Path": "/v1/itemstore/{**catch-all}",
          "Methods": [ "GET" ]
        }
      },
      "items-admin": {
        "ClusterId": "items-store",
        "AuthorizationPolicy": "AdminOnly",
        "RateLimiterPolicy": "Gateway",
        "Match": {
          "Path": "/v1/itemstore/{**catch-all}",
          "Methods": [ "POST", "PATCH", "DELETE" ]
        }
      },
      "groups-admin": {
        "ClusterId": "group-requests",
        "Order": -100,
        "AuthorizationPolicy": "AdminOnly",
        "RateLimiterPolicy": "Gateway",
        "Match": {
          "Path": "/v1/grouprequests/admin",
          "Methods": [ "GET", "DELETE" ]
        }
      },
      "groups-me": {
        "ClusterId": "group-requests",
        "Order": -90,
        "AuthorizationPolicy": "Authenticated",
        "RateLimiterPolicy": "Gateway",
        "Match": {
          "Path": "/v1/grouprequests/me",
          "Methods": [ "GET" ]
        }
      },
      "groups-write": {
        "ClusterId": "group-requests",
        "AuthorizationPolicy": "Authenticated",
        "RateLimiterPolicy": "Gateway",
        "Match": {
          "Path": "/v1/grouprequests/{**catch-all}",
          "Methods": [ "POST", "DELETE" ]
        }
      },
      "groups-read": {
        "ClusterId": "group-requests",
        "AuthorizationPolicy": "Anonymous",
        "RateLimiterPolicy": "Gateway",
        "Match": {
          "Path": "/v1/grouprequests/{**catch-all}",
          "Methods": [ "GET" ]
        }
      },
      "notification-favorites-admin": {
        "ClusterId": "user-notification",
        "Order": -100,
        "AuthorizationPolicy": "AdminOnly",
        "RateLimiterPolicy": "Gateway",
        "Match": {
          "Path": "/v1/user-notification/favorites",
          "Methods": [ "GET" ]
        }
      },
      "notification-api": {
        "ClusterId": "user-notification",
        "AuthorizationPolicy": "Authenticated",
        "RateLimiterPolicy": "Gateway",
        "Match": {
          "Path": "/v1/user-notification/{**catch-all}"
        }
      },
      "notification-hub": {
        "ClusterId": "user-notification",
        "AuthorizationPolicy": "Authenticated",
        "RateLimiterPolicy": "Gateway",
        "TimeoutPolicy": "Disable",
        "Match": {
          "Path": "/hubs/user-notifications/{**catch-all}"
        }
      },
      "audit-api": {
        "ClusterId": "audit",
        "AuthorizationPolicy": "Authenticated",
        "RateLimiterPolicy": "Gateway",
        "Match": {
          "Path": "/v1/audit/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "users-directory": {
        "LoadBalancingPolicy": "RoundRobin",
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:10",
            "Timeout": "00:00:02",
            "Policy": "ConsecutiveFailures",
            "Path": "/health"
          },
          "Passive": {
            "Enabled": true,
            "Policy": "TransportFailureRate",
            "ReactivationPeriod": "00:00:30"
          }
        },
        "Destinations": {
          "primary": {
